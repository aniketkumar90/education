{
  "version": 2,
  "buildCommand": "npm install --prefix client --include=dev && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
