# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection String (ensure 0.0.0.0/0 IP whitelist in Atlas Network Access)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/education?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Allowed Client URLs for CORS (comma-separated for multiple origins, e.g., local + production + Godaddy domain)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app,https://yourdomain.com

# Cloudinary Credentials (get these from your Cloudinary dashboard: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
